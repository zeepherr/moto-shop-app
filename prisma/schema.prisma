// Prisma schema for moto-care-app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum PaymentMethod {
  CASH
  QR
}

enum UserRole {
  ADMIN
  STAFF
  MEMBER
}

enum EnrollmentMethod {
  SELF_SERVICE
  ASSISTED
}

enum EnrollmentStatus {
  APPROVED
  AWAITING_OTP
  AWAITING_PASSWORD_SETUP
  COMPLETED
  CANCELLED
  EXPIRED
}

enum UserAuditAction {
  ENROLLMENT_CREATED
  REGISTRATION_LINK_SENT
  REGISTRATION_LINK_DELIVERY_FAILED
  ENROLLMENT_OTP_SENT
  ENROLLMENT_OTP_DELIVERY_FAILED
  ENROLLMENT_OTP_VERIFIED
  PASSWORD_SETUP_LINK_SENT
  PASSWORD_SETUP_LINK_DELIVERY_FAILED
  ENROLLMENT_CANCELLED
  ENROLLMENT_COMPLETED
  USER_ROLE_CHANGED
  USER_EMAIL_CHANGED
  USER_PASSWORD_CHANGED
  USER_PASSWORD_RESET
  USER_DEACTIVATED
  USER_REACTIVATED
}

enum MotorType {
  AUTOMATIC
  MANUAL
}

enum CustomerType {
  MEMBER
  GUEST
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

enum MotorSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ======================================================
// MODELS
// ======================================================

// USER
model User {
  id   Int      @id @default(autoincrement())
  role UserRole @default(MEMBER)

  phone String? @unique
  email String? @unique

  firstName String
  lastName  String
  password  String

  isActive                   Boolean   @default(true)
  emailVerifiedAt            DateTime?
  emailChangeOtpLastSentAt   DateTime?
  passwordResetOtpLastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userInfo                 UserInfo?
  userMotors               UserMotor[]
  motorSuggestions         MotorSuggestion[] @relation("MemberMotorSuggestions")
  reviewedMotorSuggestions MotorSuggestion[] @relation("MotorSuggestionReviewer")

  memberOrders    Order[] @relation("MemberOrder")
  saleOrders      Order[] @relation("Sale")
  cancelledOrders Order[] @relation("OrderCanceller")

  authSessions              AuthSession[]
  emailChangeRequest        EmailChangeRequest?
  adminPasswordResetRequest AdminPasswordResetRequest?
  auditEventsAsActor        UserAuditEvent[]           @relation("UserAuditActor")
  auditEventsAsSubject      UserAuditEvent[]           @relation("UserAuditSubject")
}

// SHOP-WIDE SETTINGS
model ShopSetting {
  id Int @id @default(1)

  productDiscountRate Decimal @default(0) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt
}

// USER INFO
model UserInfo {
  id Int @id @default(autoincrement())

  userId   Int     @unique
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AUTH SESSION
model AuthSession {
  id Int @id @default(autoincrement())

  userId Int

  refreshToken String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeRequest {
  id Int @id @default(autoincrement())

  userId       Int      @unique
  newEmail     String   @unique
  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([otpExpiresAt])
}

model AdminPasswordResetRequest {
  id Int @id @default(autoincrement())

  userId       Int      @unique
  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([otpExpiresAt])
}

// PENDING REGISTRATION
model PendingRegistration {
  id Int @id @default(autoincrement())

  email String @unique

  firstName String
  lastName  String

  passwordHash String
  otpHash      String

  expiresAt DateTime

  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ADMIN-CONTROLLED ENROLLMENT
model Enrollment {
  id Int @id @default(autoincrement())

  email String @unique

  firstName String
  lastName  String
  role      UserRole

  method EnrollmentMethod
  status EnrollmentStatus @default(APPROVED)

  passwordHash String?

  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?

  passwordSetupTokenHash String?   @unique
  passwordSetupExpiresAt DateTime?

  expiresAt   DateTime
  createdById Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents UserAuditEvent[]

  @@index([status, expiresAt])
  @@index([method, status])
}

model UserAuditEvent {
  id Int @id @default(autoincrement())

  action UserAuditAction
  detail String?

  enrollmentId  Int?
  actorUserId   Int?
  subjectUserId Int?

  createdAt DateTime @default(now())

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor      User?       @relation("UserAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject    User?       @relation("UserAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// MOTOR BRAND
model MotorBrand {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  motors Motor[]
}

// MOTOR
model Motor {
  id Int @id @default(autoincrement())

  motorBrandId Int

  model String
  type  MotorType

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  motorBrand MotorBrand @relation(fields: [motorBrandId], references: [id], onDelete: Restrict)

  userMotors UserMotor[]
  orders     Order[]

  @@unique([motorBrandId, model])
  @@index([motorBrandId])
}

// USER MOTOR
model UserMotor {
  id Int @id @default(autoincrement())

  userId       Int
  motorId      Int
  licensePlate String?

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Restrict)

  @@unique([userId, motorId])
  @@index([userId])
  @@index([motorId])
}

model MotorSuggestion {
  id Int @id @default(autoincrement())

  userId       Int
  reviewedById Int?
  brandName    String
  model        String
  type         MotorType
  licensePlate String?
  status       MotorSuggestionStatus @default(PENDING)
  reviewNote   String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  user       User  @relation("MemberMotorSuggestions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("MotorSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// PRODUCT CATEGORY
model ProductCategory {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]
}

// PRODUCT
model Product {
  id Int @id @default(autoincrement())

  productCategoryId Int

  sku         String  @unique
  name        String
  description String?

  costPrice    Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)

  stockQuantity Int @default(0)

  unit     String
  imageKey String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@index([productCategoryId])
}

// SERVICE
model Service {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  price Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]
}

// ORDER
model Order {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  memberId           Int?
  handledById        Int
  cancelledById      Int?
  motorId            Int?
  cancellationReason String?

  customerType CustomerType

  subtotal Decimal @db.Decimal(10, 2)

  discountRate   Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  finalTotal Decimal @db.Decimal(10, 2)

  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod?
  receivedAmount Decimal?       @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  member User? @relation("MemberOrder", fields: [memberId], references: [id], onDelete: SetNull)

  handledBy   User  @relation("Sale", fields: [handledById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  motor Motor? @relation(fields: [motorId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([memberId])
  @@index([handledById])
  @@index([cancelledById])
  @@index([motorId])
  @@index([createdAt])
  @@index([status])
}

// ORDER ITEM
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int

  productId Int?
  serviceId Int?

  itemType OrderItemType

  itemNameSnapshot String

  quantity Int @default(1)

  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
}
